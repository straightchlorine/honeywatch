# --- Environment ---
.env
.env.local
.env.*.local

# --- GeoIP databases ---
# (fetched by scripts/fetch-mmdb.sh, baked into image at build)
ingestor/data/*.mmdb

# --- Cowrie fs.pickle build temp ---
# build-centos-fs.sh extracts createfs here then removes it
cowrie/fs/.createfs.py

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# --- Python (api, ingestor) ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/

# Build artifacts
build/
dist/
*.egg-info/
*.egg
MANIFEST

# Tool caches
.ruff_cache/
.mypy_cache/
.pyright/
.pytest_cache/
.tox/
.nox/
.cache/
.hypothesis/

# Coverage
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

# --- LaTeX (docs) ---
docs/*.aux
docs/*.log
docs/*.fls
docs/*.fdb_latexmk
docs/*.synctex.gz
docs/*.toc

# --- Node (dashboard) ---
node_modules/
*.tsbuildinfo
.vite/
.eslintcache
.stylelintcache
*.log
.pnpm-debug.log*
npm-debug.log*
yarn-error.log*

# Playwright / Vitest artifacts
dashboard/playwright-report/
dashboard/test-results/
dashboard/coverage/
dashboard/.playwright/

# openapi-ts crash logs (written to dashboard/ on codegen failure)
dashboard/openapi-ts-error-*.log

# --- Postgres TLS  ---
postgres/tls/server.crt
postgres/tls/server.key
postgres/tls/*.pem
