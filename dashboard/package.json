{
  "name": "honeywatch-dashboard",
  "version": "v0.6.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build && node scripts/prerender-seo.mjs",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.vitest.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "openapi:gen": "openapi-ts"
  },
  "dependencies": {
    "@hey-api/client-fetch": "^0.13.1",
    "@tanstack/vue-query": "5.101.4",
    "d3-geo": "^3.1.1",
    "topojson-client": "^3.1.0",
    "vue": "3.5.41",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.0.0",
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "^1.62.1",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^25.9.2",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "2.1.9",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "i18n-iso-countries": "^7.14.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^6.0.0",
    "vitest": "^2.0.0",
    "vue-tsc": "^3.3.9"
  }
}
