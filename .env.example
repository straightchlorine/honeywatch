# NOTE: POSTGRES_USER and POSTGRES_DB are referenced literally in
# postgres/pg_hba.conf. Changing them here REQUIRES editing pg_hba.conf
# to match, otherwise every connection from the docker bridge is
# rejected and the stack fails to start.
POSTGRES_USER=honeywatch
POSTGRES_PASSWORD=changeme
POSTGRES_DB=honeywatch

FLASK_SECRET_KEY=changeme

# IP Geolocation based on MaxMind's GeoLite databases.
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# Grafana
GRAFANA_ADMIN_PASSWORD=changeme

# Honeypot's Headscale tailnet IP. nginx binds to this so the API is only
# reachable via the tailnet, not the public interface.
TS_IP=100.64.0.1

# Per-app Postgres role passwords (created by postgres/init.sh on first
# boot of the data dir). Ingestor has INSERT/SELECT/UPDATE/DELETE; api is
# SELECT-only.
POSTGRES_INGESTOR_PASSWORD=changeme
POSTGRES_API_PASSWORD=changeme

# Tailnet LISTEN-only stream role password (exposed over TLS on the
# tailnet 5432 bind; read-only replication-style consumer).
POSTGRES_STREAM_PASSWORD=changeme

# Ingestor Prometheus metrics. Off by default; flip to 1 once a scraper
# is wired. Binds to 127.0.0.1:9101 even when enabled - expose via
# sidecar or port-forward, never a public compose `ports:` mapping.
METRICS_ENABLED=0
METRICS_PORT=9101
