# NOTE: POSTGRES_USER and POSTGRES_DB are referenced in postgres/pg_hba.conf.
# Changing them here **requires** editing pg_hba.conf to match!
POSTGRES_USER=honeywatch
POSTGRES_PASSWORD=changeme
POSTGRES_DB=honeywatch

FLASK_SECRET_KEY=changeme

# IP Geolocation based on MaxMind's GeoLite databases.
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# Honeypot's Headscale tailnet IP. nginx binds to this so the API is only
# reachable via the tailnet, not the public interface.
TS_IP=100.64.0.1

# Cowrie internet-facing IP. When set, `ifconfig`/`netstat` inside the
# honeypot will show this instead of the container's NAT address.
#
# Leave unset to let cowrie auto-detect, but must **not** be empty if present.
# COWRIE_HONEYPOT_INTERNET_FACING_IP=

# Per-app Postgres role passwords (postgres/init.sh)
# Ingestor: INSERT/SELECT/UPDATE/DELETE;
# API: SELECT.
POSTGRES_INGESTOR_PASSWORD=changeme
POSTGRES_API_PASSWORD=changeme

# Ingestor Prometheus metrics. Off by default;
# Binds to 127.0.0.1:9101 even when enabled - expose via sidecar or port-forward.
METRICS_ENABLED=0
METRICS_PORT=9101
